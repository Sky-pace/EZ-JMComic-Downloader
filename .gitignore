# PyInstaller 构建产物
dist/
build/

# Python 缓存
__pycache__/
*.py[cod]
*.so

# 虚拟环境
venv/
.venv/
.JM/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 下载目录
downloads/

# 安全回收站
_to_delete/

# 历史记录（用户本地数据）
.jm_history.json

# 下载后行为设置（用户本地数据）
.jm_settings.json

# 协作文档（仅本地，不上传）
AGENTS.md
CLAUDE.md
MAINTENANCE.md

# 发版工具脚本（仅本地，不上传；install.sh 需入库，故单独放行）
tools/*
!tools/install.sh

# Release 本地归档（二进制与副本均通过 GitHub Releases 分发，不入库）
release/

# 自更新临时产物（Windows .exe 与 Linux 无扩展名二进制）
*.exe.old
*.exe.new
*.exe.swap
jmdownload.old
jmdownload.new
jmdownload.swap

# pytest 缓存
.pytest_cache/

# jmcomic源码库
jmcomic库实现/
